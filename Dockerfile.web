# Build Flutter web app
FROM ghcr.io/cirruslabs/flutter:3.44.6 AS builder

WORKDIR /app

COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

COPY . .

ARG API_BASE_URL=http://localhost:3001/api/v1
RUN printf 'API_BASE_URL=%s\n' "$API_BASE_URL" > .env

RUN flutter build web --release

# Serve static files with nginx (port 80 inside container)
FROM nginx:1.27-alpine AS runner

COPY nginx/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/build/web /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
